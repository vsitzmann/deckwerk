node_modules/
out/
build/
dist/
artifacts/
.venv-import/
.DS_Store
__pycache__/
*.py[cod]

# Presentation decks are private local data — except demo-deck, the small
# synthetic fixture the agent CLI tests copy their assets from, and the
# deckwerk_intro deck, of which only the slides and theme ship: its assets,
# edit history and agent chats stay local. (decks/* rather than decks/: git
# will not descend into an ignored directory to honour a negation.)
decks/*
!decks/demo-deck/
!decks/deckwerk_intro/
decks/deckwerk_intro/*
!decks/deckwerk_intro/deck.json
!decks/deckwerk_intro/theme.css

# Live collaboration decks are private local data, never fixtures.
collab-decks/
test_presentation.key

# Large local presentation corpus used by the importer regression suite.
example_presentations/

# Local reference presentation (>100MB, stripped from history).
reference.key
# The generated reference deck the importer tests run against is checked in.
!test/fixtures/keynote/reference.key

# Packaged installers (electron-builder output).
release/

# Local Keynote corpus used for import spot-checks.
example-keynote-decks/
!example-keynote-decks/
example-keynote-decks/*
!example-keynote-decks/empty_deck.key

# Built website (npm run build:site).
dist-site/
