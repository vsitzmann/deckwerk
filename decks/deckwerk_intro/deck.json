        },
        {
          "id": "text-yn4zg0bg-a50e",
          "x": 120,
          "y": 254,
          "w": 1680,
          "h": 700,
          "rot": 0,
          "z": 2,
          "opacity": 1,
          "class": [
            "role-body"
          ],
          "style": {
            "font-family": "\"Avenir Next\", Avenir, \"Helvetica Neue\", Inter, system-ui, sans-serif",
            "font-weight": "400",
            "font-size": "48px",
            "line-height": "1.32",
            "letter-spacing": "0",
            "color": "#191918"
          },
          "morphId": null,
          "lineageId": "text-slide-bjuw97zu-e65a-body",
          "type": "text",
          "html": "<ul><li>DeckWerk keeps a full edit history.</li><li>Agent edits and history undos themselves appear as undo operations.</li></ul>",
          "autoFit": true,
          "align": "left",
          "valign": "top"
        }
      ],
      "timeline": []
    },
    {
      "id": "slide-pjdg1nfh-a50e",
