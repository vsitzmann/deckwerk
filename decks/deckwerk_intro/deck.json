            "font-size": "108px",
            "line-height": "1",
            "letter-spacing": "-0.03em",
            "color": "#191918"
          },
          "morphId": null,
          "lineageId": "text-slide-bjuw97zu-e65a-title",
          "type": "text",
          "html": "Saving and Exporting.",
          "autoFit": true,
          "align": "left",
          "valign": "middle"
        },
        {
          "id": "text-4wqqdrtr-a50e",
          "x": 120,
          "y": 252,
          "w": 1680,
          "h": 700,
          "rot": 0,
          "z": 2,
          "opacity": 1,
          "class": [
            "role-body"
          ],
          "style": {
            "font-family": "\"Avenir Next\", Avenir, \"Helvetica Neue\", Inter, system-ui, sans-serif",
            "font-weight": "400",
            "font-size": "48px",
            "line-height": "1.32",
            "letter-spacing": "0",
            "color": "#191918"
          },
          "morphId": null,
          "lineageId": "text-slide-bjuw97zu-e65a-body",
          "type": "text",
          "html": "<ul><li>DeckWerk stores presentations as directory that contains a JSON (the actual slide contents), a CSS style file, an asset directory, the edit history, and a json with the agent chats (if any). DeckWerk itself renders presentations via HTML.</li><li>DeckWerk presentations can be exported as HTML files and asset directories that will play on any computer just via a browser.</li><li>Decks can also be exported as PDF files.</li></ul>",
          "autoFit": true,
          "align": "left",
          "valign": "top"
        }
      ],
      "timeline": []
    },
