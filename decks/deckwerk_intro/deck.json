          "morphId": null,
          "lineageId": "text-slide-cc2uyiv1-title",
          "type": "text",
          "html": "<p style=\"margin:0 0 28px; font-size:26px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#746f64;\">Key ideas</p><p style=\"margin:0; font-size:52px; line-height:1.36; font-weight:700; color:#191918;\"><span style=\"color:#9a9385; font-size:30px; letter-spacing:0.08em;\">01</span>&nbsp;&nbsp;Multi-platform and Open-Source<br><span style=\"color:#9a9385; font-size:30px; letter-spacing:0.08em;\">02</span>&nbsp;&nbsp;Collaborative via a webapp<br><span style=\"color:#9a9385; font-size:30px; letter-spacing:0.08em;\">03</span>&nbsp;&nbsp;Agent-enabled<br><span style=\"color:#9a9385; font-size:30px; letter-spacing:0.08em;\">04</span>&nbsp;&nbsp;Excellent image and video support</p>",
          "autoFit": true,
          "align": "left",
          "valign": "top",
          "layoutPlaceholder": "title"
        }
      ],
