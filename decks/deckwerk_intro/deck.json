          "type": "text",
          "html": "<p style=\"margin:0;\"><span style=\"color: rgb(25, 25, 24); font-size: 85px; font-weight: 700; letter-spacing: -0.045em;\">DeckWerk</span><span style=\"color: rgb(116, 111, 100); font-size: 0.68em; vertical-align: super;\">1</span><span style=\"color: rgb(25, 25, 24); font-size: 0.84em; font-weight: 400; letter-spacing: -0.02em;\"> is an opinionated, modern presentation software. </span></p>",
          "autoFit": true,
          "align": "left",
          "valign": "middle",
          "layoutPlaceholder": "title"
        },
        {
          "id": "text-f2c9sc0i",
