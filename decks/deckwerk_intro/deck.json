            "font-weight": "400",
            "letter-spacing": "normal"
          },
          "morphId": null,
          "lineageId": "text-slide-cc2uyiv1-title",
          "type": "text",
          "html": "<p><span style=\"color: rgb(25, 25, 24); text-align: center;\">$^1$</span><span style=\"color: rgb(25, 25, 24); font-style: italic; text-align: center;\">Deck</span><span style=\"color: rgb(25, 25, 24); text-align: center;\"> as in slide deck</span><span style=\"color: rgb(25, 25, 24); font-weight: 700; text-align: center;\"> </span><span style=\"color: rgb(25, 25, 24); font-weight: 400; text-align: center;\">and </span><span style=\"color: rgb(25, 25, 24); font-style: italic; font-weight: 400; text-align: center;\">Werk<span style=\"font-style: normal;\"> as in the German word that means</span></span><span style=\"color: rgb(25, 25, 24); font-weight: 400; text-align: center;\"> \"A work (of art, literature, etc)\", a factory, or a structure.</span></p>",
          "autoFit": true,
          "align": "left",
          "valign": "middle",
          "layoutPlaceholder": "title"
        },
        {
          "id": "text-vwj3p0fk",
