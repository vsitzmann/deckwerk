# Deploy the committed HEAD of the checkout to /srv/deckwerk/app, without sudo:
#
#   systemctl start deckwerk-update && journalctl -u deckwerk-update -n 30 --no-pager
#
# Runs a root-owned copy of deploy/update.sh (/usr/local/bin/deckwerk-update),
# so editing the checkout never changes what runs as root. npm and the build
# run as deckwerk. TeXWerk's deploy/50-werk-deploy.rules lets the checkout's
# owner start this unit (and texwerk-deploy.service) without a password.
[Unit]
Description=Deploy DeckWerk from the checkout's committed HEAD and restart

[Service]
Type=oneshot
Environment=DECKWERK_SRC=/home/vsitzmann/Work/deckwerk
ExecStart=/usr/local/bin/deckwerk-update --force
TimeoutStartSec=900
